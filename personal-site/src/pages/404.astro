---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';

const picks = projects.filter((p) => p.tier !== 'more').slice(0, 6);
---

<Base title="404: no such part" sheet="404 · Not found" noindex>
  <section class="wrap nf">
    <p class="eyebrow">Error 404 · part not found</p>
    <h1>
      <span>Open</span>
      <span class="outline">circuit</span>
    </h1>
    <svg class="trace" viewBox="0 0 600 80" aria-hidden="true">
      <path d="M0 40h180l20-24 20 48 20-48 20 48 20-24h60" fill="none" stroke="currentColor" stroke-width="2"></path>
      <circle cx="360" cy="40" r="5" fill="var(--accent)"></circle>
      <circle cx="420" cy="40" r="5" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path d="M425 40h175" fill="none" stroke="currentColor" stroke-width="2"></path>
      <text x="390" y="20" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--accent)">✕ no continuity</text>
    </svg>
    <p class="lede">
      Nothing is connected at this address. The page may have moved, or the link was mistyped. Try one of these, or press
      <kbd>/</kbd> to search.
    </p>
    <div class="cta">
      <a class="btn btn--primary" href="/">Back to the datasheet</a>
      <a class="btn" href="/#work">See the projects</a>
    </div>
    <ul class="picks">
      {
        picks.map((p) => (
          <li>
            <a href={`/work/${p.slug}`}>
              <span class="mono">{p.part}</span> {p.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .nf {
    padding-top: clamp(48px, 10vh, 120px);
    padding-bottom: 40px;
  }

  h1 {
    margin-top: 12px;
    font-stretch: 72%;
    font-weight: 820;
    font-size: clamp(3.4rem, 14vw, 10rem);
    line-height: 0.85;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
  }

  .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
  }

  .trace {
    width: min(600px, 100%);
    margin: 28px 0 8px;
    color: var(--ink);
  }

  .lede {
    max-width: 52ch;
    font-size: 1.15rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0 36px;
  }

  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--ink);
  }

  .picks a {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .picks .mono {
    font-size: 0.72rem;
    color: var(--ink-3);
  }
</style>
