---
import { profile } from '../data/profile';
import { projects } from '../data/projects';

type Item = { group: string; label: string; hint?: string; href?: string; action?: string; keywords?: string };

const items: Item[] = [
  { group: 'Go to', label: 'Research', hint: '§2', href: '/#research' },
  { group: 'Go to', label: 'Projects', hint: '§3', href: '/#work' },
  { group: 'Go to', label: 'Skills pinout', hint: '§4', href: '/#pinout', keywords: 'stack languages tools' },
  { group: 'Go to', label: 'Revision history', hint: '§5', href: '/#history', keywords: 'experience timeline work' },
  { group: 'Go to', label: 'Education & awards', hint: '§6', href: '/#education', keywords: 'imperial a level grades' },
  { group: 'Go to', label: 'Contact', hint: '§7', href: '/#contact', keywords: 'email hire' },
  { group: 'Go to', label: 'CV', hint: 'printable', href: '/cv', keywords: 'resume' },
  ...projects.map((p) => ({
    group: 'Projects',
    label: p.title,
    hint: p.part,
    href: `/work/${p.slug}`,
    keywords: `${p.kicker} ${p.category} ${p.tools.join(' ')}`,
  })),
  { group: 'Actions', label: 'Switch theme (paper / blueprint)', action: 'theme', keywords: 'dark light mode' },
  { group: 'Actions', label: 'Copy email address', hint: profile.email, action: 'copy-email' },
  { group: 'Actions', label: 'Open GitHub', hint: 'Sidi3355', href: profile.links.github },
  { group: 'Actions', label: 'Open LinkedIn', href: profile.links.linkedin },
  { group: 'Actions', label: 'Make a wave', hint: 'hero', action: 'wave', keywords: 'ripple fun' },
];
---

<dialog class="palette" aria-label="Command palette" data-palette data-email={profile.email}>
  <div class="box">
    <div class="field">
      <span class="prompt mono" aria-hidden="true">&gt;</span>
      <input
        type="text"
        placeholder="Jump to a project, section or action…"
        aria-label="Search"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <kbd>Esc</kbd>
    </div>
    <ul id="palette-list" role="listbox" aria-label="Results" data-palette-list></ul>
    <p class="empty mono" data-palette-empty hidden>No match. Try “quant”, “neuron” or “theme”.</p>
    <div class="foot mono" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span class="toast" data-palette-toast></span>
    </div>
  </div>
  <script type="application/json" data-palette-items set:html={JSON.stringify(items)} />
</dialog>

<style>
  .palette {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 96px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .palette::backdrop {
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    backdrop-filter: blur(3px);
  }

  .box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--rule-strong);
  }

  .prompt {
    color: var(--accent-ink);
    font-weight: 500;
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1rem;
  }

  ul {
    margin: 0;
    padding: 6px;
    list-style: none;
    overflow-y: auto;
  }

  ul :global(.group) {
    padding: 10px 8px 4px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  ul :global([role='option']) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 10px;
    cursor: pointer;
    font-size: 0.92rem;
  }

  ul :global([role='option'] .hint) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  ul :global([role='option'][aria-selected='true']) {
    background: var(--ink);
    color: var(--paper);
  }

  ul :global([role='option'][aria-selected='true'] .hint) {
    color: color-mix(in srgb, var(--paper) 75%, transparent);
  }

  .empty {
    margin: 0;
    padding: 18px;
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .foot {
    display: flex;
    gap: 16px;
    padding: 8px 14px;
    border-top: 1px solid var(--rule);
    font-size: 0.68rem;
    color: var(--ink-3);
  }

  .foot kbd {
    margin-right: 3px;
  }

  .toast {
    margin-left: auto;
    color: var(--accent-ink);
  }
</style>

<script>
  type Item = { group: string; label: string; hint?: string; href?: string; action?: string; keywords?: string };

  const dlg = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dlg.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const list = dlg.querySelector<HTMLUListElement>('[data-palette-list]')!;
  const empty = dlg.querySelector<HTMLElement>('[data-palette-empty]')!;
  const toast = dlg.querySelector<HTMLElement>('[data-palette-toast]')!;
  const items: Item[] = JSON.parse(dlg.querySelector('[data-palette-items]')!.textContent || '[]');
  let shown: Item[] = [];
  let active = 0;

  // Subsequence match with a bonus for word starts; good enough for ~30 items.
  function score(q: string, item: Item): number {
    if (!q) return 1;
    const hay = `${item.label} ${item.hint ?? ''} ${item.keywords ?? ''}`.toLowerCase();
    if (hay.includes(q)) return 100 - hay.indexOf(q);
    let i = 0;
    let s = 0;
    for (const ch of q) {
      const j = hay.indexOf(ch, i);
      if (j < 0) return 0;
      s += j === 0 || hay[j - 1] === ' ' ? 3 : 1;
      i = j + 1;
    }
    return s;
  }

  function render() {
    const q = input.value.trim().toLowerCase();
    shown = items
      .map((it) => ({ it, s: score(q, it) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => (q ? b.s - a.s : 0))
      .map((x) => x.it);
    active = Math.min(active, Math.max(shown.length - 1, 0));
    list.replaceChildren();
    let group = '';
    shown.forEach((it, i) => {
      if (!q && it.group !== group) {
        group = it.group;
        const g = document.createElement('li');
        g.className = 'group';
        g.setAttribute('role', 'presentation');
        g.textContent = group;
        list.append(g);
      }
      const li = document.createElement('li');
      li.id = `pal-${i}`;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(i === active));
      const label = document.createElement('span');
      label.textContent = it.label;
      li.append(label);
      if (it.hint) {
        const h = document.createElement('span');
        h.className = 'hint';
        h.textContent = it.hint;
        li.append(h);
      }
      li.addEventListener('mousemove', () => setActive(i));
      li.addEventListener('click', () => run(it));
      list.append(li);
    });
    empty.hidden = shown.length > 0;
    input.setAttribute('aria-activedescendant', shown.length ? `pal-${active}` : '');
  }

  function setActive(i: number) {
    if (i === active) return;
    list.querySelector(`#pal-${active}`)?.setAttribute('aria-selected', 'false');
    active = i;
    const el = list.querySelector(`#pal-${active}`);
    el?.setAttribute('aria-selected', 'true');
    el?.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', `pal-${active}`);
  }

  async function run(it: Item) {
    if (it.action === 'theme') {
      (window as unknown as { toggleTheme: () => void }).toggleTheme();
      return;
    }
    if (it.action === 'copy-email') {
      try {
        await navigator.clipboard.writeText(dlg.dataset.email || '');
        toast.textContent = 'Copied ✓';
      } catch {
        toast.textContent = dlg.dataset.email || '';
      }
      setTimeout(() => (toast.textContent = ''), 1800);
      return;
    }
    if (it.action === 'wave') {
      close();
      window.dispatchEvent(new CustomEvent('make-wave'));
      if (location.pathname !== '/') location.href = '/#top';
      else document.getElementById('top')?.scrollIntoView({ behavior: 'smooth' });
      return;
    }
    if (it.href) {
      close();
      if (/^https?:/.test(it.href)) window.open(it.href, '_blank', 'noopener');
      else location.href = it.href;
    }
  }

  function open() {
    if (dlg.open) return;
    input.value = '';
    active = 0;
    render();
    dlg.showModal();
    input.focus();
  }

  function close() {
    if (dlg.open) dlg.close();
  }

  input.addEventListener('input', () => {
    active = 0;
    render();
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(Math.min(active + 1, shown.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(Math.max(active - 1, 0));
    } else if (e.key === 'Enter' && shown[active]) {
      e.preventDefault();
      run(shown[active]);
    }
  });

  // Click on the backdrop closes.
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) close();
  });

  document.addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement)?.tagName) || (e.target as HTMLElement)?.isContentEditable;
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      dlg.open ? close() : open();
    } else if (e.key === '/' && !typing && !dlg.open) {
      e.preventDefault();
      open();
    }
  });

  document.querySelectorAll('[data-open-palette]').forEach((b) => b.addEventListener('click', open));
</script>
