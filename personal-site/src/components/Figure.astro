            <line x1="12" y1="112" x2="308" y2="112" class="ink" />
            {Array.from({ length: wMax + 1 }, (_, v) => (
              <line x1={f(wx(v))} y1="109" x2={f(wx(v))} y2="115" class="ink thin" />
            ))}
