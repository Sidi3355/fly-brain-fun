---
// Line-art figures, one per project, drawn in a 320×200 drafting space.
// Data-driven ones (spec, equity, neuron) use real numbers from the projects themselves.
import type { FigureKey } from '../data/projects';
import { kalshiCurve, gamingRates } from '../data/figures';

interface Props {
  name: FigureKey;
  label: string;
  /** Unique suffix for SVG ids when several figures share a page. */
  uid?: string;
  size?: 'card' | 'large';
}

const { name, label, uid = name, size = 'card' } = Astro.props;
const id = (s: string) => `${s}-${uid}`;
const f = (n: number) => Math.round(n * 10) / 10;
const pts = (arr: [number, number][]) => arr.map(([x, y]) => `${f(x)},${f(y)}`).join(' ');

// ── spec: gaming rate per model with 95% CIs ──
const specX = (p: number) => 96 + p * 200;
const specRows = gamingRates.map((r, i) => ({ ...r, y: 34 + i * 24 }));

// ── gwave: lee waves over a ridge ──
const ridge = (x: number) => 44 * Math.exp(-(((x - 112) / 30) ** 2));
const groundPts: [number, number][] = Array.from({ length: 81 }, (_, i) => [i * 4, 184 - ridge(i * 4)]);
const env = (x: number) => (x < 100 ? 0 : (1 - Math.exp(-(x - 100) / 18)) * Math.exp(-(x - 100) / 260));
const streams = Array.from({ length: 6 }, (_, k) => {
  const kb = 5 - k; // 0 at the bottom
  const y0 = 38 + k * 22;
  const follow = 0.9 * Math.exp(-kb * 0.38);
  const A = 3.5 + kb * 1.3;
  return Array.from({ length: 81 }, (_, i) => {
    const x = i * 4;
    return [x, y0 - ridge(x) * follow + A * Math.sin((2 * Math.PI * (x - 112)) / 62 - kb * 0.55) * env(x)] as [number, number];
  });
});

// ── refusal: projecting r out of x ──
const O = [92, 170];
const X = [182, 40];
const ang = (-25 * Math.PI) / 180;
const r = [Math.cos(ang), Math.sin(ang)];
const dot = (X[0] - O[0]) * r[0] + (X[1] - O[1]) * r[1];
const P = [O[0] + dot * r[0], O[1] + dot * r[1]];
const Abl = [O[0] + (X[0] - P[0]), O[1] + (X[1] - P[1])];
const rEnd = [O[0] + 225 * r[0], O[1] + 225 * r[1]];
const rUnit = [O[0] + 62 * r[0], O[1] + 62 * r[1]];
const perp = [-r[1], r[0]];
const sq = 7;
const rightAngle = [
  [P[0] - r[0] * sq, P[1] - r[1] * sq],
  [P[0] - r[0] * sq - perp[0] * sq, P[1] - r[1] * sq - perp[1] * sq],
  [P[0] - perp[0] * sq, P[1] - perp[1] * sq],
] as [number, number][];

// ── equity: Kalshi cumulative P&L ──
const curve = kalshiCurve.curve;
const cMin = Math.min(0, ...curve);
const cMax = Math.max(...curve);
const ex = (i: number) => 24 + (i / (curve.length - 1)) * 238;
const ey = (v: number) => 168 - ((v - cMin) / (cMax - cMin)) * 132;
const eqPts: [number, number][] = curve.map((v, i) => [ex(i), ey(v)]);
const eqArea = `M${f(ex(0))},${f(ey(0))} L${pts(eqPts)} L${f(ex(curve.length - 1))},${f(ey(0))} Z`;
let peakI = 0;
let ddFrom = 0;
let ddTo = 0;
let dd = 0;
curve.forEach((v, i) => {
  if (v > curve[peakI]) peakI = i;
  if (curve[peakI] - v > dd) {
    dd = curve[peakI] - v;
    ddFrom = peakI;
    ddTo = i;
  }
});

// ── walk: Recamán-style passcode walk ──
const walk = [0];
const seen = new Set([0]);
for (let n = 1; n <= 17; n++) {
  const prev = walk[n - 1];
  const next = prev - n > 0 && !seen.has(prev - n) ? prev - n : prev + n;
  walk.push(next);
  seen.add(next);
}
const wMax = Math.max(...walk);
const wx = (v: number) => 16 + (v / wMax) * 288;
const arcs = walk.slice(1).map((v, i) => {
  const a = wx(walk[i]);
  const b = wx(v);
  const rad = Math.abs(b - a) / 2;
  const up = i % 2 === 0;
  return { d: `M${f(a)},112 A${f(rad)},${f(rad)} 0 0 ${a < b === up ? 1 : 0} ${f(b)},112`, last: i === walk.length - 2 };
});

// ── fpl: clusters of team form ──
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const gauss = () => (rand() + rand() + rand() - 1.5) * 1.15;
const clusters = [
  { cx: 86, cy: 62, label: 'hard' },
  { cx: 168, cy: 112, label: 'medium' },
  { cx: 246, cy: 150, label: 'easy' },
].map((c) => ({ ...c, dots: Array.from({ length: 9 }, () => [c.cx + gauss() * 22, c.cy + gauss() * 14] as [number, number]) }));
---

<figure class:list={['fig', `fig--${size}`]}>
  {
    name === 'neuron' ? (
      <div class="neuron" role="img" aria-label={label}>
        <div class="neuron-mask" />
        <div class="scale" aria-hidden="true">
          <span class="bar" />
          <span class="lbl-html">100 µm</span>
        </div>
      </div>
    ) : (
      <svg viewBox="0 0 320 200" role="img" aria-label={label} preserveAspectRatio="xMidYMid meet">
        <defs>
          <pattern id={id('hatch')} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="5" class="hatch-line" />
          </pattern>
          <marker id={id('arrow')} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 10 5 0 10z" class="fill-ink" />
          </marker>
          <marker id={id('arrow-acc')} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 10 5 0 10z" class="fill-acc" />
          </marker>
        </defs>

        {name === 'spec' && (
          <g>
            <text x="8" y="16" class="lbl cap">Gamed the suite · % of trials · 95% CI</text>
            {[0, 0.25, 0.5, 0.75, 1].map((t) => (
              <g>
                <line x1={specX(t)} y1="24" x2={specX(t)} y2="176" class={t === 0.5 ? 'ink thin dash' : 'ink faint'} />
                <text x={specX(t)} y="190" class="lbl" text-anchor="middle">{t * 100}%</text>
              </g>
            ))}
            {specRows.map((m) => (
              <g>
                <text x="8" y={m.y + 3} class="lbl">{m.model}</text>
                <line x1={specX(m.lo)} y1={m.y} x2={specX(m.hi)} y2={m.y} class="ink" />
                <line x1={specX(m.lo)} y1={m.y - 4} x2={specX(m.lo)} y2={m.y + 4} class="ink" />
                <line x1={specX(m.hi)} y1={m.y - 4} x2={specX(m.hi)} y2={m.y + 4} class="ink" />
                <circle cx={specX(m.rate)} cy={m.y} r="4" class={m.rate > 0.5 ? 'fill-acc' : 'fill-paper ink'} />
              </g>
            ))}
          </g>
        )}

        {name === 'gwave' && (
          <g>
            {streams.map((s, k) => (
              <polyline points={pts(s)} class={k === 1 ? 'ink acc' : 'ink thin'} />
            ))}
            <path d={`M0,200 L${pts(groundPts)} L320,200 Z`} style={`fill:url(#${id('hatch')});stroke:none`} />
            <polyline points={pts(groundPts)} class="ink" />
            <line x1="10" y1="22" x2="58" y2="22" class="ink" marker-end={`url(#${id('arrow')})`} />
            <text x="10" y="16" class="lbl">wind U</text>
            <rect x="214" y="186" width="72" height="12" class="fill-paper" />
            <text x="250" y="195" class="lbl" text-anchor="middle">lee waves →</text>
          </g>
        )}

        {name === 'refusal' && (
          <g>
            <line x1={O[0]} y1={O[1]} x2={f(rEnd[0])} y2={f(rEnd[1])} class="ink thin dash" />
            <line x1={O[0]} y1={O[1]} x2={X[0]} y2={X[1]} class="ink" marker-end={`url(#${id('arrow')})`} />
            <line x1={X[0]} y1={X[1]} x2={f(P[0])} y2={f(P[1])} class="ink thin dash" />
            <polyline points={pts(rightAngle)} class="ink thin" />
            <line x1={O[0]} y1={O[1]} x2={f(rUnit[0])} y2={f(rUnit[1])} class="ink acc thick" marker-end={`url(#${id('arrow-acc')})`} />
            <line x1={O[0]} y1={O[1]} x2={f(Abl[0])} y2={f(Abl[1])} class="ink" marker-end={`url(#${id('arrow')})`} />
            <circle cx={O[0]} cy={O[1]} r="2.5" class="fill-ink" />
            <text x={X[0] + 6} y={X[1] + 2} class="lbl em">x</text>
            <text x={f(rUnit[0]) + 4} y={f(rUnit[1]) + 14} class="lbl em acc-t">r</text>
            <text x={f(Abl[0]) - 4} y={f(Abl[1]) - 8} class="lbl" text-anchor="middle">x − (r·x) r</text>
            <text x="312" y="192" class="lbl" text-anchor="end">W ← W − r rᵀ W</text>
            <text x="312" y="16" class="lbl" text-anchor="end">residual stream</text>
          </g>
        )}

        {name === 'equity' && (
          <g>
            <line x1="24" y1={f(ey(0))} x2="262" y2={f(ey(0))} class="ink thin dash" />
            <path d={eqArea} class="wash" />
            <polyline points={pts(eqPts)} class="ink acc" />
            <line x1={f(ex(ddFrom))} y1={f(ey(curve[ddFrom]))} x2={f(ex(ddFrom))} y2={f(ey(curve[ddTo]))} class="ink thin dash" />
            <line x1={f(ex(ddFrom)) - 4} y1={f(ey(curve[ddTo]))} x2={f(ex(ddTo)) + 4} y2={f(ey(curve[ddTo]))} class="ink thin dash" />
            <circle cx={f(ex(curve.length - 1))} cy={f(ey(curve[curve.length - 1]))} r="3" class="fill-acc" />
            <text x="268" y={f(ey(curve[curve.length - 1])) + 3} class="lbl em">+${kalshiCurve.total.toFixed(2)}</text>
            <text x="20" y={f(ey(0)) + 3} class="lbl" text-anchor="end">$0</text>
            <text x="24" y="188" class="lbl">29 Jul</text>
            <text x="262" y="188" class="lbl" text-anchor="end">27 Aug 2026</text>
            <text x="24" y="20" class="lbl cap">
              {kalshiCurve.markets} markets · {kalshiCurve.fills.toLocaleString('en-GB')} fills · max DD −${Math.abs(kalshiCurve.maxDrawdown).toFixed(2)} (dashed)
            </text>
          </g>
        )}

        {name === 'gru' && (
          <g>
            <text x="8" y="18" class="lbl cap">Weighted Pearson · 600-sequence validation slice</text>
