            <text x={f(wx(0))} y="128" class="lbl" text-anchor="middle">0</text>
            <text x={f(wx(wMax))} y="128" class="lbl" text-anchor="middle">{wMax}</text>
            <text x="12" y="20" class="lbl cap">step n: passcode ± aₙ, never revisiting</text>
            <text x="308" y="192" class="lbl" text-anchor="end">ℓ = 2 guesses suffice</text>
          </g>
        )}

        {name === 'fpl' && (
          <g>
            <line x1="28" y1="178" x2="306" y2="178" class="ink" marker-end={`url(#${id('arrow')})`} />
            <line x1="28" y1="178" x2="28" y2="16" class="ink" marker-end={`url(#${id('arrow')})`} />
            <text x="306" y="192" class="lbl" text-anchor="end">goals conceded →</text>
            <text x="34" y="24" class="lbl">form</text>
            {clusters.map((c, i) => (
              <g>
                <ellipse cx={c.cx} cy={c.cy} rx="40" ry="26" class={i === 2 ? 'ink acc dash' : 'ink thin dash'} />
                {c.dots.map(([x, y]) => (
                  <circle cx={f(x)} cy={f(y)} r="2.6" class={i === 2 ? 'fill-acc' : 'fill-ink'} />
                ))}
                <text x={c.cx + 44} y={c.cy - 18} class="lbl">{c.label}</text>
              </g>
            ))}
          </g>
        )}

        {name === 'overnight' && (
          <g>
            <line x1="10" y1="132" x2="310" y2="132" class="ink" />
            <rect x="16" y="120" width="96" height="24" class="fill-paper ink" />
            <rect x="222" y="120" width="96" height="24" class="fill-paper ink" />
            <text x="64" y="135" class="lbl" text-anchor="middle">session</text>
            <text x="270" y="135" class="lbl" text-anchor="middle">session</text>
            <path d="M112 112 C 140 52, 194 52, 222 112" class="ink acc thick" marker-end={`url(#${id('arrow-acc')})`} />
            <path d="M167 60 a10 10 0 1 0 9 14 a8 8 0 1 1 -9 -14z" class="fill-acc" />
            <line x1="112" y1="112" x2="112" y2="160" class="ink thin dash" />
            <line x1="222" y1="112" x2="222" y2="160" class="ink thin dash" />
            <text x="112" y="172" class="lbl" text-anchor="middle">16:00 MOC buy</text>
            <text x="222" y="172" class="lbl" text-anchor="middle">09:30 MOO sell</text>
            <text x="167" y="40" class="lbl" text-anchor="middle">hold IWM overnight</text>
          </g>
        )}

        {name === 'aero' && (
          <g>
            <line x1="8" y1="160" x2="312" y2="160" class="ink" />
            <path d="M24 136 L60 134 L96 120 L132 112 L150 98 L170 96 L182 108 L232 112 L268 104 L300 104 L300 122 L250 132 L60 140 Z" class="fill-paper ink" />
            <path d="M60 140 L250 132" class="ink acc thick" />
            <circle cx="76" cy="138" r="18" class="fill-paper ink" />
            <circle cx="76" cy="138" r="6" class="ink thin" />
            <circle cx="246" cy="138" r="20" class="fill-paper ink" />
            <circle cx="246" cy="138" r="7" class="ink thin" />
            {[110, 150, 190].map((x) => (
              <line x1={x} y1="58" x2={x} y2="84" class="ink acc" marker-end={`url(#${id('arrow-acc')})`} />
            ))}
            <text x="150" y="48" class="lbl" text-anchor="middle">downforce</text>
            {[146, 151].map((y, i) => (
              <path d={`M100 ${y} Q 160 ${y + (i ? 3 : -2)} 220 ${y - 2}`} class="ink thin dash" />
            ))}
            <line x1="164" y1="135" x2="164" y2="159" class="ink thin" marker-start={`url(#${id('arrow')})`} marker-end={`url(#${id('arrow')})`} />
            <text x="170" y="178" class="lbl">ride height 8–12 mm</text>
            <text x="8" y="20" class="lbl cap">L/D ≥ 3.2 · &lt;0.8% loss per mm</text>
          </g>
        )}

        {name === 'car' && (
          <g>
            <line x1="8" y1="150" x2="312" y2="150" class="ink" />
            <path d="M40 128 C 50 96, 120 82, 190 86 C 240 88, 280 104, 290 126 L 286 132 L 44 134 Z" class="fill-paper ink" />
            <circle cx="150" cy="80" r="14" class="fill-paper ink" />
            <path d="M138 78 h24" class="ink thin" />
            <circle cx="78" cy="134" r="16" class="fill-paper ink" />
            <circle cx="252" cy="134" r="16" class="fill-paper ink" />
            <circle cx="78" cy="134" r="4" class="fill-ink" />
            <circle cx="252" cy="134" r="4" class="fill-ink" />
            <line x1="40" y1="172" x2="290" y2="172" class="ink thin" marker-start={`url(#${id('arrow')})`} marker-end={`url(#${id('arrow')})`} />
            <line x1="40" y1="164" x2="40" y2="178" class="ink thin" />
            <line x1="290" y1="164" x2="290" y2="178" class="ink thin" />
            <text x="165" y="168" class="lbl" text-anchor="middle">2.2 m</text>
            <rect x="200" y="100" width="20" height="12" class="fill-acc" />
            <polyline points={pts(Array.from({ length: 30 }, (_, i) => [214 + i * 3, 38 - Math.sin(i * 0.4) * 6 - i * 0.4]))} class="ink acc" />
            <line x1="210" y1="100" x2="220" y2="52" class="ink thin dash" />
            <text x="214" y="22" class="lbl">thermistor telemetry</text>
          </g>
        )}
      </svg>
    )
  }
</figure>

<style>
  .fig {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 10;
    color: var(--ink);
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .fig :global(.ink) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .fig :global(.thin) {
    stroke-width: 0.8;
  }

  .fig :global(.thick) {
    stroke-width: 2.2;
  }

  .fig :global(.faint) {
    stroke: var(--rule);
  }

  .fig :global(.acc) {
    stroke: var(--accent);
  }

  .fig :global(.dash) {
    stroke-dasharray: 3 3;
  }

  .fig :global(.fill-ink) {
    fill: currentColor;
  }

  .fig :global(.fill-acc) {
    fill: var(--accent);
    stroke: none;
  }

  .fig :global(.fill-paper) {
    fill: var(--paper);
  }

  .fig :global(.fill-faint) {
    fill: var(--rule-strong);
  }

  .fig :global(.wash) {
    fill: var(--accent-wash);
    stroke: none;
  }

  .fig :global(.hatch-line) {
    stroke: var(--hatch);
    stroke-width: 1.4;
  }

  .fig :global(.limb) {
    stroke: var(--paper-3);
    stroke-width: 18;
    stroke-linecap: round;
  }

  .fig :global(.limb.foot) {
    stroke-width: 10;
  }

  .fig :global(.lbl) {
    font-family: var(--font-mono);
    font-size: 8.5px;
    fill: var(--ink-2);
  }

  /* Large figures render ~2.4× their drafting size, so labels are drawn smaller to land near 14px. */
  .fig--large {
    max-width: 760px;
  }

  .fig--large :global(.lbl) {
    font-size: 6px;
  }

  @media (max-width: 700px) {
    .fig--large :global(.lbl) {
      font-size: 8.5px;
    }
  }

  .fig :global(.lbl.cap) {
    fill: var(--ink-3);
    letter-spacing: 0.02em;
  }

  .fig :global(.lbl.em) {
    fill: var(--ink);
    font-weight: 500;
  }

  .fig :global(.lbl.inv) {
    fill: var(--paper);
  }

  .fig :global(.acc-t) {
    fill: var(--accent-ink);
  }

  /* The neuron is a real FlyWire skeleton, used as a mask so it takes the theme's ink. */
  .neuron {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .neuron-mask {
    position: absolute;
    inset: 0;
    background: var(--ink);
    -webkit-mask: url('/figures/lobula-plate.svg') center / contain no-repeat;
    mask: url('/figures/lobula-plate.svg') center / contain no-repeat;
  }

  .scale {
    position: absolute;
    left: 4%;
    bottom: 4%;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 18.58%; /* 100 µm at this figure's scale, from scripts/figures */
    padding-bottom: 1px;
    background: var(--paper);
  }

  .scale .bar {
    height: 2px;
    background: var(--accent);
  }

  .lbl-html {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-2);
  }
</style>
