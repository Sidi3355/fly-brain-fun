            <line x1="189" y1="99" x2="204" y2="99" class="ink" marker-end={`url(#${id('arrow')})`} />
            <rect x="210" y="36" width="96" height="124" class="fill-paper ink" />
            <rect x="210" y="36" width="96" height="16" class="fill-ink" />
            <text x="216" y="47" class="lbl inv">AUTO</text>
