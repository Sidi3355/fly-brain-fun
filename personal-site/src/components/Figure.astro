        {name === 'laser' && (
          <g>
            <rect x="22" y="44" width="200" height="132" class="fill-paper ink" />
            {Array.from({ length: 9 }, (_, r) =>
              Array.from({ length: 13 }, (_, c) => <circle cx={34 + c * 15} cy={56 + r * 14} r="1" class="fill-faint" />),
            )}
            <rect x="56" y="74" width="120" height="76" style={`fill:url(#${id('hatch')})`} class="ink" />
            <rect x="50" y="68" width="132" height="88" class="ink acc dash" />
            <rect x="50" y="56" width="104" height="12" class="fill-acc" />
            <text x="54" y="65" class="lbl inv">plywood 3 mm · 0.94</text>
