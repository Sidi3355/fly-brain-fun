              <g>
                <line x1={110 + (t - 0.6) * 1900} y1="30" x2={110 + (t - 0.6) * 1900} y2="160" class="ink faint" />
                <text x={110 + (t - 0.6) * 1900} y="174" class="lbl" text-anchor="middle">{t.toFixed(2)}</text>
              </g>
            ))}
            {[
              { k: 'Official baseline', v: 0.6238, y: 46 },
              { k: 'GRU-256, scratch', v: 0.6762, y: 86 },
              { k: 'GRU-192, shipped', v: 0.6826, y: 126 },
            ].map((b, i) => (
              <g>
                <text x="8" y={b.y + 13} class="lbl">{b.k}</text>
                <rect x="110" y={b.y} width={f((b.v - 0.6) * 1900)} height="20" class={i === 2 ? 'fill-acc' : 'fill-paper ink'} />
                <text x={f(110 + (b.v - 0.6) * 1900) + 6} y={b.y + 13} class="lbl em">{b.v.toFixed(3)}</text>
              </g>
            ))}
            <text x="8" y="192" class="lbl">Public leaderboard: 0.648</text>
          </g>
        )}

        {name === 'pill' && (
          <g>
            <rect x="14" y="16" width="292" height="170" class="fill-paper ink" />
            <line x1="14" y1="32" x2="306" y2="32" class="ink thin" />
            <circle cx="24" cy="24" r="2.5" class="ink thin" />
            <circle cx="33" cy="24" r="2.5" class="ink thin" />
            <circle cx="42" cy="24" r="2.5" class="ink thin" />
            {[48, 62, 76, 90, 104, 118, 132, 146, 160].map((y, i) => (
              <line x1="28" y1={y} x2={[170, 182, 150, 176, 168, 140, 178, 160, 120][i]} y2={y} class="ink faint thick" />
            ))}
            <rect x="60" y="85" width="92" height="10" class="wash" />
            <line x1="60" y1="90" x2="152" y2="90" class="ink thick" />
            <rect x="120" y="100" width="54" height="16" rx="8" class="fill-ink" />
            <text x="147" y="111" class="lbl inv" text-anchor="middle">✦ explain</text>
            <path d="M166 112 l0 14 l4 -4 l3 7 l3 -1.5 l-3 -7 l5.5 0 z" class="fill-paper ink thin" />
            <g class="slide">
              <rect x="196" y="38" width="104" height="142" class="fill-paper ink" />
              <rect x="196" y="38" width="104" height="16" class="fill-ink" />
              <text x="204" y="49" class="lbl inv">SAURUS</text>
              {[66, 76, 86, 100, 110, 120, 130, 144, 154].map((y, i) => (
                <line x1="204" y1={y} x2={[290, 284, 262, 292, 280, 288, 250, 276, 240][i]} y2={y} class={i < 3 ? 'ink acc' : 'ink faint'} />
              ))}
              <rect x="204" y="164" width="88" height="10" class="ink thin" />
            </g>
          </g>
        )}

        {name === 'runner' && (
          <g>
            {[0, 1, 2].map((k) => (
              <circle cx={120 + k * 18} cy={102 - Math.sin((k / 2) * Math.PI) * 6} r="2" class="ink thin" />
            ))}
            <line x1="10" y1="174" x2="310" y2="174" class="ink" />
            <g class="ink thick">
              <line x1="167" y1="54" x2="150" y2="102" />
              <line x1="150" y1="102" x2="178" y2="132" />
              <line x1="178" y1="132" x2="174" y2="170" />
              <line x1="174" y1="170" x2="188" y2="172" />
              <line x1="150" y1="102" x2="128" y2="128" />
              <line x1="128" y1="128" x2="100" y2="140" />
              <line x1="100" y1="140" x2="94" y2="132" />
              <line x1="163" y1="62" x2="184" y2="84" />
              <line x1="184" y1="84" x2="196" y2="70" />
              <line x1="163" y1="62" x2="148" y2="86" />
              <line x1="148" y1="86" x2="136" y2="98" />
            </g>
            <circle cx="172" cy="42" r="10" class="fill-paper ink thick" />
            {[[150, 102], [178, 132], [174, 170], [128, 128], [100, 140], [184, 84], [148, 86], [163, 62]].map(([x, y]) => (
              <circle cx={x} cy={y} r="2.6" class="fill-acc" />
            ))}
            <line x1="178" y1="132" x2="178" y2="174" class="ink acc dash" />
            <path d="M165 118 A16 16 0 0 0 176 147" class="ink acc" />
            <text x="200" y="140" class="lbl">knee flexion θ</text>
            <text x="200" y="162" class="lbl acc-t">foot under knee ✓</text>
            <text x="12" y="20" class="lbl cap">33 landmarks · on-device</text>
          </g>
        )}

        {name === 'pitch' && (
          <g>
            <rect x="196" y="54" width="104" height="92" class="fill-paper ink" />
            <line x1="248" y1="54" x2="248" y2="146" class="ink thin" />
            <circle cx="248" cy="100" r="13" class="ink thin" />
            <rect x="196" y="78" width="16" height="44" class="ink thin" />
            <rect x="284" y="78" width="16" height="44" class="ink thin" />
            {[
              { x: 30, y: 36, d: 'M30 36 C 90 30, 140 70, 194 92', t: 'A · 18 min' },
              { x: 40, y: 168, d: 'M40 168 C 100 168, 150 130, 194 106', t: 'B · 22 min' },
              { x: 116, y: 24, d: 'M116 24 C 150 30, 180 50, 206 56', t: 'C · 25 min' },
            ].map((o, i) => (
              <g>
                <path d={o.d} class={i === 0 ? 'ink acc dash' : 'ink dash'} marker-end={`url(#${id(i === 0 ? 'arrow-acc' : 'arrow')})`} />
                <circle cx={o.x} cy={o.y} r="4" class="fill-ink" />
                <text x={o.x + (i === 1 ? 0 : 0)} y={o.y + (i === 1 ? 16 : -9)} class="lbl">{o.t}</text>
