---
import Figure from './Figure.astro';
import { categories, type Project } from '../data/projects';
import { pins } from '../data/profile';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const href = `/work/${p.slug}`;
const pinLabel = (id: string) => pins.find((x) => x.id === id);
const live = p.links.find((l) => l.kind === 'live');
const code = p.links.find((l) => l.kind === 'code');
---

<article class="card" data-cat={p.category} data-pins={p.stack.join(' ')} data-reveal>
  <a class="frame" href={href} tabindex="-1" aria-hidden="true">
    <span class="part mono">{p.part}</span>
    <Figure name={p.figure} label={p.figureCaption} uid={`card-${p.slug}`} />
  </a>
  <div class="body">
    <p class="meta mono">
      <span>{categories[p.category]}</span>
      <span>{p.date}</span>
    </p>
    <h3><a href={href}>{p.title}</a></h3>
    <p class="kicker">{p.kicker}</p>
    <dl class="metrics">
      {
        p.metrics.slice(0, 2).map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>
    <ul class="pins mono" aria-label="Stack">
      {
        p.stack.slice(0, 5).map((s) => {
          const pin = pinLabel(s);
          return pin && <li title={pin.name}>{pin.label}</li>;
        })
      }
    </ul>
    <div class="links mono">
      <a class="more" href={href}>Datasheet <span aria-hidden="true">→</span></a>
      {live && <a href={live.href}>Live<span class="ext" aria-hidden="true" /></a>}
      {code && <a href={code.href}>Code<span class="ext" aria-hidden="true" /></a>}
      {p.source === 'private' && <span class="note">Source private</span>}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .card[hidden] {
    display: none;
  }

  .card.is-dim {
    opacity: 0.32;
  }

  .card.is-lit {
    box-shadow: 5px 5px 0 var(--accent);
  }

  .frame {
    position: relative;
    display: block;
    padding: 18px 18px 12px;
    border-bottom: 1px solid var(--rule-strong);
    background-image:
      linear-gradient(var(--grid-minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
    background-size: 12px 12px;
  }

  .part {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    padding: 2px 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 18px 18px;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  h3 {
    font-stretch: 85%;
    font-size: 1.55rem;
    line-height: 1.05;
  }

  h3 a {
    text-decoration: none;
  }

  /* Whole card is clickable through the title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .kicker {
    margin: 6px 0 14px;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0 0 14px;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .metrics div {
    display: flex;
    flex-direction: column;
  }

  .metrics dd {
    order: -1;
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 80%;
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1.1;
    color: var(--accent-ink);
  }

  .metrics dt {
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .pins {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }

  .pins li {
    padding: 0 6px;
    border: 1px solid var(--rule-strong);
    font-size: 0.66rem;
    line-height: 1.7;
  }

  .links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    margin-top: auto;
    font-size: 0.78rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .more {
    font-weight: 500;
  }

  .note {
    color: var(--ink-3);
    font-size: 0.7rem;
  }
</style>
